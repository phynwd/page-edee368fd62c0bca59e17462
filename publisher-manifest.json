ay: inline-block;padding: 10px 24px;font-size: 14px;font-weight: 800;border: 2px solid #121217;background: #121217;color: #ffffff}\n.plan-card.featured .btn-select {background: #7022f4;border-color: #121217}\n.clients-panel {border: 3px solid #121217;background: #ffffff;padding: 36px;box-shadow: 6px 6px 0 #121217;margin-bottom: 64px}\n.client-steps {display: grid;grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));gap: 20px;margin-top: 24px}\n.step-item {border: 2px solid #121217;padding: 20px;background: #fafafc}\n.step-num {font-size: 12px;font-weight: 900;color: #7022f4;text-transform: uppercase;margin-bottom: 8px}\n.step-item h4 {font-size: 16px;font-weight: 800;margin-bottom: 6px}\n.step-item p {font-size: 13px;color: #555566}\n.faq-wrap {display: flex;flex-direction: column;gap: 16px;margin-bottom: 64px}\ndetails {border: 3px solid #121217;background: #ffffff;box-shadow: 4px 4px 0 #121217;overflow: hidden}\nsummary {font-size: 16px;font-weight: 800;padding: 20px 24px;cursor: pointer;background: #ffffff;list-style: none;display: flex;justify-content: space-between;align-items: center}\nsummary::-webkit-details-marker {display: none}\nsummary::after {content: \"+\";font-size: 20px;font-weight: 900;color: #7022f4;margin-left: 16px}\ndetails[open] summary::after {content: \"—\"}\ndetails[open] summary {border-bottom: 2px solid #121217;background: #faf8ff}\n.faq-answer {padding: 20px 24px;font-size: 14px;color: #444455;background: #ffffff;line-height: 1.7}\n.footer-note {border: 3px solid #121217;background: #e8dbff;padding: 24px;text-align: center;font-size: 14px;font-weight: 600}\n@media (max-width: 860px) {\n  .shell {flex-direction: column}\n  .side-nav {width: 100%;height: auto;position: relative;border-right: none;border-bottom: 3px solid #121217;padding: 24px}\n  .nav-tree {flex-direction: row;flex-wrap: wrap;gap: 8px;margin-top: 20px}\n  .nav-tree a {padding: 6px 12px;font-size: 13px}\n  .nav-meta {display: none}\n  .content-area {padding: 32px 18px 64px}\n  .hero-block {padding: 28px 20px;box-shadow: 5px 5px 0 #121217}\n  h1 {font-size: 28px}\n  .plan-card {padding: 20px;box-shadow: 4px 4px 0 #121217}\n  .plan-header {flex-direction: column;align-items: flex-start}\n  .plan-rate {text-align: left}\n}\n</style><div class=\"shell\">\n\n  <nav class=\"side-nav\" aria-label=\"页面目录导航\">\n    <div>\n      <div class=\"brand-mark\">knotic</div>\n      <ul class=\"nav-tree\">\n        <li><a href=\"#overview\">接入历程</a></li>\n        <li><a href=\"#plans\">订阅计划</a></li>\n        <li><a href=\"#setup\">客户端配置</a></li>\n        <li><a href=\"#faq\">常见答疑</a></li>\n      </ul>\n    </div>\n    <div class=\"nav-meta\">\n      <strong>日常连接小记</strong><br>\n      整理自实际使用体验与方案参数，界面无套路，简单直白。\n    </div>\n  </nav>\n\n  <main class=\"content-area\">\n\n    <section id=\"overview\" class=\"hero-block\">\n      <span class=\"hero-badge\">网络漫游随笔</span>\n      <h1>knotic 选型与日常使用笔记</h1>\n      <p class=\"hero-intro\">\n        嗨，如果你也在寻找一个不用天天操心、参数透明的节点方案，这里把我整理的 knotic 使用节奏和选型对比全摊开给你看。不玩虚浮辞藻，只讲实在体验。\n      </p>\n\n      <div class=\"timeline-intro\">\n        <div class=\"timeline-step active\">\n          <div class=\"timeline-dot\"></div>\n          <h3>01. 初步了解：找准自己的用量边界</h3>\n          <p>很多人一开始就直接买最大规格，其实日常查资料、发邮件和偶尔刷刷网页，每个月几十上百吉字节完全足够。理清自己的真实需求是避坑的第一步。</p>\n        </div>\n\n        <div class=\"timeline-step active\">\n          <div class=\"timeline-dot\"></div>\n          <h3>02. 配置就绪：通用协议与客户端匹配</h3>\n          <p>不用强绑单一专用软件。把订阅地址导入你顺手的开源核心工具里，核对本地网络策略，两分钟搞定分流规则。</p>\n        </div>\n\n        <div class=\"timeline-step\">\n          <div class=\"timeline-dot\"></div>\n          <h3>03. 融入日常：多端设备保持常态在线</h3>\n          <p>电脑写代码、手机看消息、平板查文档，设备之间互不抢占连接槽位，安静地充当数字生活的背景底座。</p>\n        </div>\n\n        <div class=\"timeline-step\">\n          <div class=\"timeline-dot\"></div>\n          <h3>04. 定期回顾：随工作流调整规格</h3>\n          <p>如果后续需要更充裕的带宽或更密集的团队协作，再平滑升级也不迟。保持轻装上阵才最舒服。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"section-head\">\n        <h2>订阅计划详情</h2>\n        <p>所有档位参数直接列出，单列铺开，你可以一眼看清每月的流量额度与设备上限。</p>\n      </div>\n\n      <div class=\"plans-stack\">\n        <article class=\"plan-card\">\n          <div class=\"plan-header\">\n            <div class=\"plan-title-area\">\n              <h3>基础版</h3>\n              <p>适合个人轻度查阅资料与日常基础漫游</p>\n            </div>\n            <div class=\"plan-rate\">\n              <div class=\"plan-price\">¥15/月</div>\n              <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-footer\">\n            <a href=\"#\" class=\"btn-select\">确认选择基础档位</a>\n          </div>\n        </article>\n\n        <article class=\"plan-card featured\">\n          <span class=\"plan-tag\">多数人的均衡首选</span>\n          <div class=\"plan-header\">\n            <div class=\"plan-title-area\">\n              <h3>旗舰版</h3>\n              <p>兼顾影音流媒体、低延迟游戏与多设备协同</p>\n            </div>\n            <div class=\"plan-rate\">\n              <div class=\"plan-price\">¥35/月</div>\n              <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-footer\">\n            <a href=\"#\" class=\"btn-select\">确认选择旗舰档位</a>\n          </div>\n        </article>\n\n        <article class=\"plan-card\">\n          <div class=\"plan-header\">\n            <div class=\"plan-title-area\">\n              <h3>团队版</h3>\n              <p>为小型工作室或多终端重度环境量身打造</p>\n            </div>\n            <div class=\"plan-rate\">\n              <div class=\"plan-price\">¥85/月</div>\n              <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-footer\">\n            <a href=\"#\" class=\"btn-select\">确认选择团队档位</a>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"setup\" class=\"clients-panel\">\n      <div class=\"section-head\">\n        <h2>客户端接入说明</h2>\n        <p>我们没有强推任何封装的专有下载包，你可以自由使用业内通用的开源客户端进行配置。</p>\n      </div>\n\n      <div class=\"client-steps\">\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 01</div>\n          <h4>获取专属订阅</h4>\n          <p>确认好计划后，在你的后台复制节点订阅 URL 地址，妥善保存，避免转借他人泄露限额。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 02</div>\n          <h4>选择通用软件</h4>\n          <p>桌面端建议使用 Clash 或 Sing-box 核心工具；移动端按平台喜好搭配通用代理代理工具即可。</p>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">Step 03</div>\n          <h4>导入并测试规则</h4>\n          <p>粘贴订阅链接并完成规则更新，推荐选用“规则分流”模式，既不浪费节点流量也不拖慢局域网。</p>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"section-head\">\n        <h2>常见问答</h2>\n        <p>整理了朋友们初次接触 knotic 时最常问到的几个细节。</p>\n      </div>\n\n      <div class=\"faq-wrap\">\n        <details>\n          <summary>流量额度用尽了会怎么样？</summary>\n          <div class=\"faq-answer\">\n            当月所包含的高速流量达到上限后，连接将暂停服务，直到下一个账单周期自动重置。如果手头有紧急需求，可以在后台根据需要调整更高的套餐档位。\n          </div>\n        </details>\n\n        <details>\n          <summary>几台设备同时在线是如何计算的？</summary>\n          <div class=\"faq-answer\">\n            同时在线数量是指在同一时刻与节点池建立活动连接的物理终端数。例如基础版支持 3 台，那么你的手机、笔记本和办公室电脑同时连接即为满额，离开办公室关掉连接后名额即刻释放。\n          </div>\n        </details>\n\n        <details>\n          <summary>为什么年付会比按月付费划算？</summary>\n          <div class=\"faq-answer\">\n            按年付结算折算下来相当于只收 10 个月的费用，另外赠送了 2 个月的使用时长，适合打算长期固定使用的朋友；如果你只是临时短期测验，先选月付体验最为稳妥。\n          </div>\n        </details>\n\n        <details>\n          <summary>旗舰版的 IPLC 专线和普通线路有什么区别？</summary>\n          <div class=\"faq-answer\">\n            IPLC 采用的是点对点内网传输架构，不经过常规公网国际出口的拥堵路由，因此在晚高峰时段更不容易受到抖动干扰，对即时联机游戏和海外语音通话体验有明显助益。\n          </div>\n        </details>\n\n        <details>\n          <summary>不同操作系统上该去哪里下载配置客户端？</summary>\n          <div class=\"faq-answer\">\n            市面上支持通用配置协议的客户端非常丰富，如各开源社区维护的 Clash Verge、Sing-box 等。建议前往对应项目的开源代码仓库或官方应用商店获取已验证的最新发布版本。\n          </div>\n        </details>\n      </div>\n    </section>\n\n    <div class=\"footer-note\">\n      保持好奇，克制折腾。knotic 愿作为你桌面角落里踏实无感的小工具。\n    </div>\n\n  </main>\n</div>",
